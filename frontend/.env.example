# Plantilla de variables de entorno del frontend PigTec.
# Uso: copia este archivo como ".env.local" y reemplaza los valores reales.
# IMPORTANTE: no incluir credenciales reales en el repositorio.

# --- API del backend PigTec ---
# URL base del backend local (Fastify). Sin barra final.
VITE_API_BASE_URL=http://127.0.0.1:3000

# --- Supabase Auth (SOLO clave publica) ---
# El frontend usa Supabase Auth para iniciar sesion y obtener el JWT que envia
# al backend. La clave "anon" es PUBLICA por diseno y esta protegida por RLS.
#
# PROHIBIDO en el frontend:
#   - la clave "service_role" de Supabase,
#   - GROQ_API_KEY o cualquier secreto del servidor.
# Esos valores viven unicamente en backend/.env.
VITE_SUPABASE_URL=https://example-project.supabase.co
VITE_SUPABASE_ANON_KEY=example-anon-key-not-real
