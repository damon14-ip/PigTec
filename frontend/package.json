{
  "name": "pigtec-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend de PigTec (React + TypeScript + Vite)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
