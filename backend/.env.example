# Plantilla de variables de entorno del backend PigTec.
# Uso: copia este archivo como ".env" y reemplaza los valores.
# IMPORTANTE: no incluir credenciales reales en el repositorio.

# --- Servidor HTTP ---
PORT=3000
HOST=127.0.0.1

# --- Supabase ---
# Valores de EJEMPLO, no reales. La clave anon es publica, pero aun asi
# los valores reales no deben subirse a Git.
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_ANON_KEY=example-anon-key-not-real
