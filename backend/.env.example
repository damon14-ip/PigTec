# Plantilla de variables de entorno del backend PigTec.
# Uso: copia este archivo como ".env" y reemplaza los valores.
# IMPORTANTE: no incluir credenciales reales en el repositorio.

# --- Servidor HTTP ---
PORT=3000
HOST=127.0.0.1

# --- CORS (lista blanca de origenes del navegador) ---
# Origenes autorizados a llamar a la API desde el navegador, separados por comas.
# PROHIBIDO usar el comodin "*": expondria la API a sitios de terceros.
# En desarrollo, el frontend Vite sirve en http://127.0.0.1:5173.
# Si se omite, se usa este valor por defecto.
# En produccion, fija aqui el origen real del frontend (p. ej. https://pigtec.example).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173

# --- Supabase ---
# Valores de EJEMPLO, no reales. La clave anon es publica, pero aun asi
# los valores reales no deben subirse a Git.
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_ANON_KEY=example-anon-key-not-real

# --- Asistente IA (Groq) ---
# Clave de API de Groq. SECRETO: no subir valores reales a Git.
# Si falta GROQ_API_KEY o GROQ_MODEL, el asistente queda deshabilitado
# (las rutas /assistant/* responden 502) y el backend arranca igualmente.
GROQ_API_KEY=example-groq-api-key-not-real
# Modelo compatible con la API de OpenAI de Groq.
GROQ_MODEL=openai/gpt-oss-20b
# Limite diario de solicitudes a Groq para TODO PigTec.
# El valor es un entero positivo; si falta o es invalido se usa 20.
# NOTA: en esta primera version el contador vive EN MEMORIA por proceso:
#   - se reinicia al reiniciar el servidor,
#   - NO se comparte entre instancias (multiinstancia multiplicaria el cupo),
#   - reinicia a las 00:00 UTC.
# No es suficiente para un despliegue multiinstancia; se sustituira por un
# contador compartido y atomico antes de escalar.
AI_DAILY_REQUEST_LIMIT=20
